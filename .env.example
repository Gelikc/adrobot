# Docker Compose configuration. For a local Python run copy to backend/.env.
KEITARO_MODE=demo
KEITARO_URL=
KEITARO_API_KEY=
# Required in live mode, at least 12 characters. Never commit the real .env.
OPERATOR_PASSWORD=
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:8080
POSTGRES_PASSWORD=adrobot-local-only
# Local backend only (Compose overrides this with PostgreSQL):
DATABASE_URL=sqlite+aiosqlite:///./adrobot.db
