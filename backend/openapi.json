  "components": {
    "schemas": {
      "AddOffer": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "offer_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Offer Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "offer_id"
        ],
        "title": "AddOffer"
      },
      "CreateCampaign": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "geo_code": {
            "type": "string",
            "title": "Geo Code"
          },
          "offer_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Offer Id"
          },
          "domain_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Domain Id"
          },
          "group_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Group Id"
          },
          "traffic_source_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Traffic Source Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "geo_code",
          "offer_id",
          "domain_id",
          "group_id",
          "traffic_source_id"
        ],
        "title": "CreateCampaign"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportCampaign": {
        "properties": {
          "remote_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Remote Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "remote_id"
        ],
        "title": "ImportCampaign"
      },
      "Login": {
        "properties": {
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password"
        ],
        "title": "Login"
      },
      "PinOffer": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "pinned": {
            "type": "boolean",
            "title": "Pinned"
          },
          "share": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Share"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "pinned"
        ],
        "title": "PinOffer"
      },
      "Revision": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision"
        ],
        "title": "Revision"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
